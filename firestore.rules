rules_version = '2';

// ============================================================
// PlayWeb Firestore セキュリティルール
// ------------------------------------------------------------
// 使い方: Firebase コンソール → Firestore Database →「ルール」タブに
// このファイルの内容を丸ごと貼り付けて「公開」を押す。
//
// データモデルの前提:
// - usernames/{usernameLower} -> { uid }        ユーザー名の確保・検索用
// - codes/{フレンドコード}     -> { uid }        コードから uid を引くため
// - users/{uid}                                  公開プロフィール
//     { username, usernameLower, friendCode, online, lastSeen, currentGame, createdAt }
// - users/{uid}/data/{doc}                       本人のみ（フレンド一覧など）
// - users/{uid}/saves/{key}                      本人のみ（クラウドセーブ）
// - invites/{id}  { toUid, fromUid, ... }        送信者と宛先のみ
// - messages/{id} { participants: [uid, uid], from, to, ... }  当事者のみ
// - feedback/{id} { type, title, body, game, fromUid, fromName,
//                   createdAt, status }          送信は誰でも可、
//                   読み取り・既読化は管理者（下記 adminUids）のみ
// - chart_submissions/{id} { songId, diff, songTitle, notes, fromUid,
//                   fromName, status, createdAt } 太鼓の譜面エディタからの
//                   承認依頼。作成はログイン済み本人のみ、読み・状態更新は
//                   管理者のみ
// - official_charts/{songId__diff} { notes, fromName, approvedAt }
//                   管理者が承認した公式譜面の置き換え。読みは全員
//                   （ゲスト含む）、書きは管理者のみ
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ユーザー名 → uid（ログイン済みなら検索のため get 可。列挙は不可）
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      // 新規登録時のみ、自分の uid を指すものだけ作れる
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // 一度作った対応は変更・削除不可（乗っ取り防止）
      allow update, delete: if false;
    }

    // フレンドコード → uid（ログイン済みなら get 可。列挙は不可）
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ユーザー本体
    match /users/{uid} {
      // 公開プロフィールはログイン済みユーザーが閲覧可（ユーザー名検索・在席表示のため）
      allow get: if signedIn();
      allow list: if false;
      // 書き込みは本人のみ
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      // 非公開データ（フレンド一覧など）は本人のみ読み書き可
      match /data/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // クラウドセーブは本人のみ読み書き可
      match /saves/{key} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // 招待: 送信者と宛先のみ読み書き可
    match /invites/{inviteId} {
      allow get: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      // 一覧クエリは「自分の宛先分」「自分の送信分」の形でのみ使う前提で、
      // ドキュメント単位の条件で制限する
      allow list: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      // 作成は送信者本人を名乗るものだけ
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      // 状態更新（delivered / joined / dismissed 等）は当事者のみ
      allow update: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // チャット: 当事者（participants に自分の uid を含む）だけが読める。
    // 作成は from が自分であるものだけ。改変・削除は不可（履歴の保全）。
    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }

    // フィードバック（お問い合わせ/要望/バグ報告）:
    // 作成は誰でも可（ゲストの「ログインできない」等の不具合報告経路を
    // 塞がないため。フィールド構成と長さだけ軽く検証する）。
    // 読み取りと状態更新（既読化）は管理者のみ。削除は不可。
    // ★管理者 uid の差し替え手順:
    //   1. 管理者用アカウントを PlayWeb で作成する
    //   2. uid を確認する（Firebase コンソール → Authentication → Users の
    //      「User UID」、または管理者でログイン中にコンソールで
    //      PWAccount.user().uid）
    //   3. 下の 'REPLACE_WITH_ADMIN_UID' をその uid に書き換える
    //   4. account.js の ADMIN_UIDS 定数にも同じ uid を入れる（表示制御用）
    //   5. このファイル全体をコンソールのルール欄に貼り直して「公開」する
    function adminUids() {
      return ['9FompVx7Gpfp2f2anoz35vPyD6F3'];
    }
    function isAdmin() {
      return signedIn() && request.auth.uid in adminUids();
    }
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['type', 'title', 'body', 'game', 'fromUid', 'fromName', 'createdAt', 'status'])
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.game is string
        && request.resource.data.fromUid is string
        && request.resource.data.fromName is string
        && request.resource.data.createdAt is number
        && request.resource.data.status == 'new';
      allow get, list: if isAdmin();
      // 既読化など、status フィールドだけの更新を管理者に許可する
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ================================================================
    // 譜面エディタ（太鼓・v120〜）:
    //   chart_submissions: 編集した譜面の承認依頼。作成はログイン済みで
    //     自分の uid を名乗り、status='pending' のものだけ。フィールド構成と
    //     型だけ軽く検証する（notes は [step, type] ペアの配列）。
    //     読み取りと状態更新（承認/却下）は管理者のみ。削除は不可。
    //   official_charts: 承認済みの公式譜面置き換え（docId は
    //     "{songId}__{diff}"）。読み取りは全員（ゲストの演奏開始時にも
    //     必要なため認証なしでも可）。作成・更新・削除（公式に戻す）は
    //     管理者のみ。
    // ================================================================
    match /chart_submissions/{docId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
            ['songId', 'diff', 'songTitle', 'notes', 'fromUid', 'fromName', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.songId is string
        && request.resource.data.songId.size() > 0
        && request.resource.data.songId.size() <= 40
        && request.resource.data.diff is string
        && request.resource.data.songTitle is string
        && request.resource.data.songTitle.size() <= 60
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 4000
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 30
        && request.resource.data.createdAt is number;
      allow get, list: if isAdmin();
      // 承認/却下は status フィールドだけの更新を管理者に許可する
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }
    match /official_charts/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // ================================================================
    // matches/{matchId} : ターン制ゲームの対戦ドキュメント（v55〜・match.js）
    //   - matchId は6文字のルームコード。作成=ホストのみ、読取=当事者2人
    //     （参加待ちの対局だけは、コードを知るログイン済みユーザーが参加の
    //     ために読める）。更新は当事者、または参加待ち対局への参加
    //     （guestUid が空→自分 になる更新）のみ。削除は不可。
    //   - ⚠️ この節を本番へ反映するには、ユーザーがコンソールへこの
    //     ファイル全体を貼り直して「公開」する必要がある。
    // ================================================================
    match /matches/{matchId} {
      allow get: if signedIn()
        && (request.auth.uid in resource.data.players
            || resource.data.status == 'waiting');
      allow list: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(
            ['game', 'hostUid', 'guestUid', 'players', 'state', 'status', 'seq', 'createdAt', 'updatedAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.players == [request.auth.uid]
        && request.resource.data.status == 'waiting';
      allow update: if signedIn()
        && request.resource.data.game == resource.data.game
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.players.hasAll(resource.data.players)
        && (request.auth.uid in resource.data.players
            || (resource.data.status == 'waiting'
                && resource.data.guestUid == ''
                && request.resource.data.guestUid == request.auth.uid));
      allow delete: if false;
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
